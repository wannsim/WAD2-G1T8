# Copy this file to "config.env" (same folder) and fill in the values. config.env is never committed.
# MongoDB connection string (MongoDB Atlas -> Connect -> Drivers). Ask the team for the shared one.
DB=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/homly-hauls?retryWrites=true&w=majority
# Google sign-in (Google Cloud Console -> Credentials -> OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
# Optional: YouTube Data API v3 key for the "trending on YouTube" boost on the Trending tab.
# Without it the app still works; Trending then uses on-site orders, saves and views only.
YOUTUBE_API_KEY=
# Optional: API port (the client expects 8000)
PORT=8000
# Optional: free Gemini API key (aistudio.google.com -> Get API key). Gemini double-checks each YouTube pull
# and drops videos that are not really about the product. Without it, only the word-match rules are used.
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-flash-lite-latest, which has the biggest free quota)
# GEMINI_MODEL=
